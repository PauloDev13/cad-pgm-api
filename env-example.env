# ==========================================
# CONEXÃO COM O BANCO DE DADOS
# ==========================================
SPRING_DATASOURCE_URL=url de conexão com banco de dados
SPRING_DATASOURCE_USERNAME=usuario do banco de dados
SPRING_DATASOURCE_PASSWORD=senha do usuario do banco de dados

# ==========================================
# CONFIGURAÇÕES DO MINIO LOCAL
# ==========================================
# URL interna: como o backend "enxerga" o MinIO dentro da rede do Docker
MINIO_URL=URL interna: como o backend "enxerga" o MinIO dentro da rede
# URL pública: como o navegador do usuário acessará o link do PDF
MINIO_PUBLIC_URL=como o navegador do usuário acessará o link do PDF
MINIO_ACCESS_KEY=user
MINIO_SECRET_KEY=password

# ==========================================
# CONFIGURAÇÕES DE E-MAIL
# ==========================================
MAIL_USERNAME=email que será usado para enviar link de recuperação senha
MAIL_PASSWORD=senha do email de envio do link configurada nas permissões do google.

# ==========================================
# SEGURANÇA
# ==========================================
JWT_SECRET=chave segura com hash 256

# ==========================================
# ROTAS DO FRONTEND
# ==========================================
# Descomente e preencha a variável abaixo caso o sistema
# vá rodar em um domínio oficial (ex: https://sistemas.pgm.rn.gov.br).
# Se deixada comentada, o sistema assumirá http://localhost:8080 por padrão.
# FRONTEND_URLS=https://sistemasrh.pgm.intranet.natal.rn.gov.br,http://localhost:8080,http://localhost:4200