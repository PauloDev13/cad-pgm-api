# ==========================================
# CONEXÃO COM O BANCO DE DADOS
# ==========================================
DB_ROOT_PASS=
DB_NAME=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ==========================================
# CONFIGURAÇÕES DO MINIO
# ==========================================
# URL interna: como o backend "enxerga" o MinIO dentro da rede do Docker
MINIO_URL=
# URL pública: como o navegador do usuário acessará o link do PDF
MINIO_PUBLIC_URL=
MINIO_USER=
MINIO_PASS=


# ==========================================
# CONFIGURAÇÕES DE E-MAIL
# ==========================================
# Envio de email para recuperação de senha
MAIL_USERNAME=
MAIL_PASSWORD=

# Envio de email para lista dos certificados à vencer
CERTIFICADO_MAIL_REMETENTE=
CERTIFICADO_MAIL_DESTINATARIO=

# ==========================================
# SEGURANÇA
# ==========================================
# chave segura com hash 256 para descriptografar o token JWT
JWT_SECRET=

# ==========================================
# ROTA NO ENVIRONMENTS DO ANGULAR
# ==========================================
# O valor da variável será injetado nas variáveis de ambiente (environment e
# environment.development) do angular. Se a variável for omitida, assumira omitida
# o valor padrão: http://localhost:8080
API_URL=

# ============================================
# ROTA PARA O ANGULAR ACESSAR O BACKEND PYTHON
# ============================================
# O valor da variável deve conter o IP do host onde o backend Python está rodando
# Pode ser o mesmo PC onde o ambiente Docker está instalado ou outro PC
PYTHON_HOST=

# ==========================================
# ROTAS DO FRONTEND
# ==========================================
# Array de URLs permitidas para fazer requisições ao backend
# Se deixada comentada, o sistema assumirá http://localhost:8080 por padrão.
# A variável pode receber vários domínios separados por vírgula.
# Ex: https://sistemas.pgm.rn.gov.br,http://localhost:8080,http://10.19.1.36.
FRONTEND_URLS=